# Public site origin without a trailing slash.
# Local: http://localhost:3000
# Replace example.com with the confirmed production origin before launch.
NEXT_PUBLIC_SITE_URL=https://example.com

# Public contact. These are the current corporate baseline values.
NEXT_PUBLIC_PUBLIC_EMAIL=contacto@andariohospitality.com
NEXT_PUBLIC_WHATSAPP_PHONE=573213660046
NEXT_PUBLIC_ADDRESS="Calle 13B # 4A-63"
NEXT_PUBLIC_CITY=Valledupar
NEXT_PUBLIC_COUNTRY=Colombia

# Map pin. Leave both empty until the coordinates are confirmed.
# Do not invent them. The site omits the map link when either value is missing.
NEXT_PUBLIC_LATITUDE=
NEXT_PUBLIC_LONGITUDE=

# Official profiles. Empty values are omitted from the site.
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_GOOGLE_PROFILE_URL=

# GA4 measurement ID, e.g. G-XXXXXXXX. Empty = no analytics script.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Server-only. Never prefix these with NEXT_PUBLIC_.
# The public contact form posts to /api/leads, which forwards to Google Apps Script.
# Leave the URL empty until the Apps Script web app is deployed. See GOOGLE_SHEETS_SETUP.md.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_TOKEN=

# Older server webhook for POST /api/contact. The public form does not call that route.
CONTACT_FORM_WEBHOOK_URL=
CONTACT_FORM_WEBHOOK_SECRET=
